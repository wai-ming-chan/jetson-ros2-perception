<?xml version="1.0"?>
<package format="3">
  <name>jetson_bringup</name>
  <version>0.1.0</version>
  <description>
    Single entry point for the whole stack: camera, detector and operator console.
  </description>
  <maintainer email="waiming@galeelee.com">wai-ming</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>jetson_camera</exec_depend>
  <exec_depend>trt_detector</exec_depend>
  <exec_depend>operator_console</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
